{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ltolocal.example/schemas/roundabout-furniture.v0.schema.json",
  "title": "Roundabout Furniture v0",
  "type": "object",
  "required": ["roundaboutFurnitureFormatVersion", "packId", "origin", "source", "roundabouts"],
  "properties": {
    "roundaboutFurnitureFormatVersion": { "type": "string", "const": "0.1" },
    "packId": { "type": "string", "minLength": 1 },
    "origin": {
      "type": "object",
      "required": ["lat", "lon"],
      "properties": {
        "lat": { "type": "number" },
        "lon": { "type": "number" }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["kind", "licence", "attribution", "diagramRefs"],
      "properties": {
        "kind": { "type": "string" },
        "licence": { "type": "string" },
        "attribution": { "type": "string" },
        "generator": { "type": "string" },
        "styleSources": {
          "type": "array",
          "items": { "type": "string", "format": "uri" }
        },
        "diagramRefs": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "roundabouts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "nodeIds", "islandPolygon", "roundaboutSigns", "chevronBoards", "giveWayLines"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "nodeIds": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "islandPolygon": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "type": "number" }
            }
          },
          "roundaboutSigns": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "approachLinkId", "x", "z", "heading", "diagramRef"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "approachLinkId": { "type": "string", "minLength": 1 },
                "x": { "type": "number" },
                "z": { "type": "number" },
                "heading": { "type": "number", "minimum": 0, "maximum": 360 },
                "diagramRef": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          },
          "chevronBoards": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "approachLinkId", "x", "z", "heading", "diagramRef"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "approachLinkId": { "type": "string", "minLength": 1 },
                "x": { "type": "number" },
                "z": { "type": "number" },
                "heading": { "type": "number", "minimum": 0, "maximum": 360 },
                "diagramRef": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          },
          "giveWayLines": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "approachLinkId", "x", "z", "heading", "widthM", "diagramRef"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "approachLinkId": { "type": "string", "minLength": 1 },
                "x": { "type": "number" },
                "z": { "type": "number" },
                "heading": { "type": "number", "minimum": 0, "maximum": 360 },
                "widthM": { "type": "number", "minimum": 2 },
                "diagramRef": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
