<Project>
  <!-- Keep build output out of the source folders: Sim.Core is also a Unity package,
       and Unity would otherwise import the compiled DLLs in bin/ and obj/. -->
  <PropertyGroup>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
  </PropertyGroup>
</Project>
