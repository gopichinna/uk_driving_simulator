{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ltolocal.example/schemas/signs-placed.v0.schema.json",
  "title": "Signs Placed v0 (Direction Signs, Street Name Plates, Speed Signs, Bus Stops, Warning Signs)",
  "type": "object",
  "required": ["signsFormatVersion", "packId", "origin", "source"],
  "properties": {
    "signsFormatVersion": { "type": "string", "const": "0.1" },
    "packId": { "type": "string", "minLength": 1 },
    "origin": {
      "type": "object",
      "required": ["lat", "lon"],
      "properties": {
        "lat": { "type": "number" },
        "lon": { "type": "number" }
      },
      "additionalProperties": false
    },
    "headingConvention": {
      "type": "string",
      "description": "Degrees clockwise from +z (North): 0=+z, 90=+x, 180=-z, 270=-x"
    },
    "source": {
      "type": "object",
      "required": ["kind", "licence", "attribution"],
      "properties": {
        "kind": { "type": "string" },
        "licence": { "type": "string" },
        "attribution": { "type": "string" },
        "generator": { "type": "string" },
        "styleSources": {
          "type": "array",
          "items": { "type": "string", "format": "uri" }
        },
        "diagramRefs": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "signs": {
      "type": "array",
      "items": { "$ref": "#/$defs/directionSign" }
    },
    "plates": {
      "type": "array",
      "items": { "$ref": "#/$defs/streetNamePlate" }
    },
    "speedSigns": {
      "type": "array",
      "items": { "$ref": "#/$defs/speedSign" }
    },
    "busStops": {
      "type": "array",
      "items": { "$ref": "#/$defs/busStop" }
    },
    "warningSigns": {
      "type": "array",
      "items": { "$ref": "#/$defs/warningSign" }
    },
    "motorwaySigns": {
      "type": "array",
      "items": { "$ref": "#/$defs/motorwaySign" }
    }
  },
  "oneOf": [
    { "required": ["signs"] },
    { "required": ["plates"] },
    { "required": ["speedSigns"] },
    { "required": ["busStops"] },
    { "required": ["warningSigns"] },
    { "required": ["motorwaySigns"] }
  ],
  "additionalProperties": false,
  "$defs": {
    "directionSign": {
      "type": "object",
      "required": ["id", "nodeId", "approachLinkId", "x", "z", "heading", "style", "rows"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "nodeId": { "type": "string", "minLength": 1 },
        "approachLinkId": { "type": "string", "minLength": 1 },
        "x": { "type": "number" },
        "z": { "type": "number" },
        "heading": { "type": "number", "minimum": 0, "maximum": 360 },
        "distanceBeforeJunctionM": { "type": "number", "minimum": 20, "maximum": 60 },
        "style": { "type": "string", "enum": ["primary", "local"] },
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["text", "direction", "symbol"],
            "properties": {
              "text": { "type": "string", "minLength": 1 },
              "poiId": { "type": "string", "minLength": 1 },
              "ref": { "type": "string", "minLength": 1 },
              "symbol": {
                "type": "string",
                "enum": ["rail", "bus", "hospital", "parking", "city_centre", "none"]
              },
              "direction": {
                "type": "string",
                "enum": ["ahead", "left", "right", "ahead_left", "ahead_right"]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "streetNamePlate": {
      "type": "object",
      "required": ["id", "nodeId", "linkId", "x", "z", "heading", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "nodeId": { "type": "string", "minLength": 1 },
        "linkId": { "type": "string", "minLength": 1 },
        "x": { "type": "number" },
        "z": { "type": "number" },
        "heading": { "type": "number", "minimum": 0, "maximum": 360 },
        "name": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "speedSign": {
      "type": "object",
      "required": ["id", "x", "z", "heading", "mph", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "x": { "type": "number" },
        "z": { "type": "number" },
        "heading": { "type": "number", "minimum": 0, "maximum": 360 },
        "mph": { "type": "integer", "minimum": 5, "maximum": 70 },
        "kind": { "type": "string", "enum": ["start", "repeater"] },
        "linkId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "busStop": {
      "type": "object",
      "required": ["id", "x", "z", "heading", "name", "linkId"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "x": { "type": "number" },
        "z": { "type": "number" },
        "heading": { "type": "number", "minimum": 0, "maximum": 360 },
        "name": { "type": "string", "minLength": 1 },
        "linkId": { "type": "string", "minLength": 1 },
        "osmId": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "warningSign": {
      "type": "object",
      "required": ["id", "kind", "x", "z", "heading"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": ["school", "road_humps", "road_narrows", "pedestrians_in_road", "queues_likely", "bend_ahead"]
        },
        "x": { "type": "number" },
        "z": { "type": "number" },
        "heading": { "type": "number", "minimum": 0, "maximum": 360 },
        "linkId": { "type": "string", "minLength": 1 },
        "diagramRef": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "motorwaySign": {
      "type": "object",
      "required": ["id", "kind", "x", "z", "heading", "style"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": [
            "advance_1m",
            "advance_half_m",
            "final_exit",
            "countdown_3",
            "countdown_2",
            "countdown_1",
            "junction_number",
            "emergency_area"
          ]
        },
        "x": { "type": "number" },
        "z": { "type": "number" },
        "heading": { "type": "number", "minimum": 0, "maximum": 360 },
        "style": { "type": "string", "enum": ["motorway", "emergency_area"] },
        "junctionNumber": { "type": "string", "minLength": 1 },
        "bars": { "type": "integer", "minimum": 1, "maximum": 3 },
        "text": { "type": "string", "minLength": 1 },
        "routeNumber": { "type": "string", "minLength": 1 },
        "linkId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
