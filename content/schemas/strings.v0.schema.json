{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ltolocal.app/schemas/strings.v0.schema.json",
  "title": "L to Local Strings v0",
  "description": "Player-facing rule strings and glossary entries (CEFR B1, ICU MessageFormat). Shared contract (docs/08 §4).",
  "type": "object",
  "oneOf": [
    {
      "required": ["stringsFormatVersion", "country", "language", "kind", "rules"],
      "additionalProperties": false,
      "properties": {
        "stringsFormatVersion": { "const": "0.1" },
        "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "language": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
        "kind": { "const": "rules" },
        "rules": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^GB\\.[A-Z]+\\.[A-Z0-9_]+$": { "$ref": "#/$defs/ruleString" }
          }
        }
      }
    },
    {
      "required": ["stringsFormatVersion", "country", "language", "kind", "terms"],
      "additionalProperties": false,
      "properties": {
        "stringsFormatVersion": { "const": "0.1" },
        "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "language": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
        "kind": { "const": "glossary" },
        "terms": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/glossaryEntry" }
        }
      }
    },
    {
      "required": ["stringsFormatVersion", "country", "language", "kind", "entries"],
      "additionalProperties": false,
      "properties": {
        "stringsFormatVersion": { "const": "0.1" },
        "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "language": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
        "kind": { "const": "ui" },
        "entries": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z0-9_]+(\\.[a-z0-9_]+)+$": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  ],
  "$defs": {
    "ruleString": {
      "type": "object",
      "required": ["title", "fault", "why", "tip"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "fault": { "type": "string", "minLength": 1 },
        "why": { "type": "string", "minLength": 1 },
        "tip": { "type": "string", "minLength": 1 },
        "good": { "type": "string", "minLength": 1 }
      }
    },
    "glossaryEntry": {
      "type": "object",
      "required": ["id", "term", "definition", "relatedRules"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "term": { "type": "string", "minLength": 1 },
        "definition": { "type": "string", "minLength": 1 },
        "relatedRules": {
          "type": "array",
          "items": { "type": "string", "pattern": "^GB\\.[A-Z]+\\.[A-Z0-9_]+$" }
        },
        "kmhHint": { "type": "string" }
      }
    }
  }
}
