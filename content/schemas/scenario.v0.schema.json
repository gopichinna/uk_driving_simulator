{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ltolocal.app/schemas/scenario.v0.schema.json",
  "title": "L to Local Lesson Scenario v0",
  "description": "Scripted lesson scenario with fixed event vocabulary for the scenario player. Shared contract (docs/08 §4).",
  "type": "object",
  "required": ["scenarioFormatVersion", "scenarioId", "course", "anchor", "durationS", "events"],
  "additionalProperties": false,
  "properties": {
    "scenarioFormatVersion": { "const": "0.1" },
    "scenarioId": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "course": {
      "enum": [
        "town",
        "roundabout",
        "two_lane_roundabout",
        "dual_carriageway",
        "wolverhampton",
        "wolverhampton-test-area",
        "motorway",
        "suburb_practice",
        "rural_practice",
        "ring_road_practice",
        "coventry"
      ]
    },
    "anchor": {
      "enum": [
        "crossroads_signals",
        "tjunction_north",
        "tjunction_south",
        "zebra",
        "box_junction",
        "school_street",
        "start",
        "join",
        "leave"
      ]
    },
    "durationS": { "type": "integer", "minimum": 60, "maximum": 3600 },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 3 },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["type", "crossing", "whenPlayerWithinM"],
            "additionalProperties": false,
            "properties": {
              "type": { "const": "pedestrian_waits" },
              "crossing": { "enum": ["zebra", "mill_lane_mouth", "church_st_mouth"] },
              "whenPlayerWithinM": { "type": "number", "minimum": 1 }
            }
          },
          {
            "type": "object",
            "required": ["type", "crossing", "whenPlayerWithinM"],
            "additionalProperties": false,
            "properties": {
              "type": { "const": "pedestrian_steps_out" },
              "crossing": { "enum": ["zebra", "mill_lane_mouth", "church_st_mouth"] },
              "whenPlayerWithinM": { "type": "number", "minimum": 1 }
            }
          },
          {
            "type": "object",
            "required": ["type", "junction", "whenPlayerWithinM", "gapS"],
            "additionalProperties": false,
            "properties": {
              "type": { "const": "car_emerges" },
              "junction": { "enum": ["tjunction_north", "tjunction_south"] },
              "whenPlayerWithinM": { "type": "number", "minimum": 1 },
              "gapS": { "type": "number", "minimum": 0.5 }
            }
          },
          {
            "type": "object",
            "required": ["type", "anchor", "offsetM"],
            "additionalProperties": false,
            "properties": {
              "type": { "const": "parked_car" },
              "anchor": { "$ref": "#/$defs/anchorEnum" },
              "offsetM": { "type": "number" }
            }
          },
          {
            "type": "object",
            "required": ["type", "anchor", "offsetM", "speedMph"],
            "additionalProperties": false,
            "properties": {
              "type": { "const": "cyclist_ahead" },
              "anchor": { "$ref": "#/$defs/anchorEnum" },
              "offsetM": { "type": "number" },
              "speedMph": { "type": "number", "minimum": 1, "maximum": 30 }
            }
          },
          {
            "type": "object",
            "required": ["type", "whenPlayerWithinM"],
            "additionalProperties": false,
            "properties": {
              "type": { "const": "lights_turn_amber" },
              "whenPlayerWithinM": { "type": "number", "minimum": 1 }
            }
          },
          {
            "type": "object",
            "required": ["type", "value"],
            "additionalProperties": false,
            "properties": {
              "type": { "const": "traffic_density" },
              "value": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          },
          {
            "type": "object",
            "required": ["type", "anchor", "offsetM"],
            "additionalProperties": false,
            "properties": {
              "type": { "const": "finish_at" },
              "anchor": { "$ref": "#/$defs/anchorEnum" },
              "offsetM": { "type": "number" }
            }
          },
          {
            "type": "object",
            "required": ["type", "exitNumber"],
            "additionalProperties": false,
            "properties": {
              "type": { "const": "take_exit" },
              "exitNumber": { "type": "integer", "minimum": 1, "maximum": 4 }
            }
          },
          {
            "type": "object",
            "required": ["type", "seconds"],
            "additionalProperties": false,
            "properties": {
              "type": { "const": "finish_after_s" },
              "seconds": { "type": "number", "minimum": 10, "maximum": 180 }
            }
          },
          {
            "type": "object",
            "required": ["type", "minutes", "mode"],
            "additionalProperties": false,
            "properties": {
              "type": { "const": "independent_driving" },
              "minutes": { "type": "integer", "minimum": 1, "maximum": 60 },
              "mode": { "enum": ["satnav", "signs", "mixed"] },
              "poiId": { "type": "string", "minLength": 1 },
              "instruction": { "type": "string", "minLength": 1 }
            }
          },
          {
            "type": "object",
            "required": ["type", "timeOfDay", "weather", "visibilityM"],
            "additionalProperties": false,
            "properties": {
              "type": { "const": "conditions" },
              "timeOfDay": { "enum": ["day", "dusk", "night"] },
              "weather": { "enum": ["clear", "rain", "fog"] },
              "visibilityM": { "type": "number", "minimum": 10, "maximum": 5000 }
            }
          },
          {
            "type": "object",
            "required": ["type", "lane", "whenPlayerWithinM"],
            "additionalProperties": false,
            "properties": {
              "type": { "const": "red_x" },
              "lane": { "type": "integer", "minimum": 0, "maximum": 5 },
              "whenPlayerWithinM": { "type": "number", "minimum": 10 }
            }
          },
          {
            "type": "object",
            "required": ["type", "mph", "whenPlayerWithinM"],
            "additionalProperties": false,
            "properties": {
              "type": { "const": "variable_limit" },
              "mph": { "type": "integer", "minimum": 20, "maximum": 70 },
              "whenPlayerWithinM": { "type": "number", "minimum": 10 }
            }
          },
          {
            "type": "object",
            "required": ["type", "lane", "speedMph", "offsetM"],
            "additionalProperties": false,
            "properties": {
              "type": { "const": "slow_vehicle_ahead" },
              "lane": { "type": "integer", "minimum": 0, "maximum": 5 },
              "speedMph": { "type": "number", "minimum": 10, "maximum": 65 },
              "offsetM": { "type": "number", "minimum": 10 }
            }
          },
          {
            "type": "object",
            "required": ["type", "atM"],
            "additionalProperties": false,
            "properties": {
              "type": { "const": "breakdown" },
              "atM": { "type": "number", "minimum": 20 }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "anchorEnum": {
      "enum": [
        "crossroads_signals",
        "tjunction_north",
        "tjunction_south",
        "zebra",
        "box_junction",
        "school_street",
        "start",
        "join",
        "leave"
      ]
    }
  }
}
