{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ltolocal.app/schemas/progression.v0.schema.json",
  "title": "L to Local Lesson Progression v0",
  "description": "Stage unlocks, star rules, spaced-repetition review schedule, and free-tier list. Shared contract (docs/08 §4).",
  "type": "object",
  "required": ["progressionFormatVersion", "country", "stages", "stars", "review", "freeTier"],
  "additionalProperties": false,
  "properties": {
    "progressionFormatVersion": { "const": "0.1" },
    "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["stage", "title", "lessonIds", "unlockAfter"],
        "additionalProperties": false,
        "properties": {
          "stage": { "type": "integer", "minimum": 0 },
          "title": { "type": "string", "minLength": 1 },
          "lessonIds": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
          },
          "unlockAfter": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["stage", "minStars"],
            "properties": {
              "stage": { "type": "integer", "minimum": 0 },
              "minStars": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "stars": {
      "type": "object",
      "required": ["one", "two", "three"],
      "additionalProperties": false,
      "properties": {
        "one": { "$ref": "#/$defs/starRule" },
        "two": { "$ref": "#/$defs/starRule" },
        "three": { "$ref": "#/$defs/starRule" }
      }
    },
    "review": {
      "type": "object",
      "required": ["intervalsDays", "maxPerDay"],
      "additionalProperties": false,
      "properties": {
        "intervalsDays": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1 }
        },
        "maxPerDay": { "type": "integer", "minimum": 1 }
      }
    },
    "freeTier": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
    },
    "optionalPractice": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "course", "scenarioIds", "unlockAfter"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "course": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
          "scenarioIds": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[a-z0-9_]+$" }
          },
          "unlockAfter": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stage", "minStars"],
            "properties": {
              "stage": { "type": "integer", "minimum": 0 },
              "minStars": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "starRule": {
      "type": "object",
      "required": ["requirement", "label"],
      "additionalProperties": false,
      "properties": {
        "requirement": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "testMarkingRefs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
