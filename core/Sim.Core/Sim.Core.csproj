<Project Sdk="Microsoft.NET.Sdk">

  <!-- Engine-free simulation core. Must stay compatible with Unity:
       .NET Standard 2.1, C# 9, and no UnityEngine references (ADR-004). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>LToLocal.Sim</RootNamespace>
  </PropertyGroup>

</Project>
