{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ltolocal.app/schemas/signs.v0.schema.json",
  "title": "L to Local Traffic Signs v0",
  "description": "Country traffic-sign catalogue with TSRGD diagram numbers, plain-English meanings, licence metadata, and optional local image paths. Shared contract (docs/08 §4).",
  "type": "object",
  "required": ["signsFormatVersion", "country", "licence", "signs"],
  "additionalProperties": false,
  "properties": {
    "signsFormatVersion": { "const": "0.1" },
    "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "licence": {
      "type": "object",
      "required": ["status", "name", "url", "notes"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["verified", "UNVERIFIED"] },
        "name": { "type": "string" },
        "url": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "signs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sign" }
    }
  },
  "$defs": {
    "sign": {
      "type": "object",
      "required": ["id", "name", "tsrgdDiagram", "category", "meaning", "relatedRules", "sourceUrl", "image"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^GB\\.SIGN\\.[A-Z0-9_]+$" },
        "name": { "type": "string", "minLength": 1 },
        "tsrgdDiagram": { "type": "string", "minLength": 1 },
        "category": { "enum": ["regulatory", "warning", "information"] },
        "meaning": { "type": "string", "minLength": 1 },
        "relatedRules": {
          "type": "array",
          "items": { "type": "string", "pattern": "^GB\\.[A-Z]+\\.[A-Z0-9_]+$" }
        },
        "sourceUrl": { "type": "string" },
        "image": { "type": ["string", "null"] }
      }
    }
  }
}
