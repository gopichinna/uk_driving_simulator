  "learnCard": {
    "blocks": [
      "Always drive in the left lane unless you are overtaking slower traffic.",
      "Overtake on the right, then move back left as soon as it is safe.",
      "Do not overtake on the left unless traffic is moving in slow queues."
    ],
    "ruleIds": [
      "GB.MWY.KEEP_LEFT",
